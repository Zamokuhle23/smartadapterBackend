# --- Core Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# Leave unset for quick local dev on SQLite.
# For PostgreSQL (production + pgvector), set the full URL:
#   postgres://user:pass@host:5432/fundzaai?sslmode=require
# Then ensure the pgvector extension is enabled on that DB:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=

# --- Redis (Celery broker + Channels layer) ---
# Leave unset to use in-memory/in-process fallbacks in development.
REDIS_URL=

# --- LLM provider (question generation + grading: quality-critical) ---
# Choose one:
#   openai (default) -> OpenRouter or any OpenAI-compatible /chat/completions endpoint
#   azure            -> Azure OpenAI (uses an api-key header + /openai/deployments URL)
#   azure_ai         -> Azure AI Foundry serverless / Models-as-a-Service (Phi/Llama);
#                       model name goes in the request BODY, URL is /models/chat/completions
#   azure_sdk        -> Azure OpenAI-SDK-compatible endpoint (".../openai/v1" + /chat/completions)
#                       ^^^ USE THIS for the endpoint your playground sample gave you
LLM_PROVIDER=azure_sdk

# --- Single cheap model for everything (Phi-4-mini) ---
AZURE_OPENAI_API_KEY=<your-project-key>
LLM_BASE_URL=https://zamokuhlemasondo6-1675-resource.services.ai.azure.com/openai/v1
LLM_MODEL=Phi-4-mini                 # deployment name, sent in the request BODY

# Optional: separate cheaper model for high-volume chat (leave same if not deployed).
# CHAT_LLM_PROVIDER=azure_sdk
# CHAT_LLM_MODEL=Phi-4-mini
# CHAT_AZURE_OPENAI_API_KEY=

# --- Azure OpenAI-SDK-compatible (LLM_PROVIDER=azure_sdk) -> RECOMMENDED for your setup ---
# Matches the endpoint from the Azure playground sample (base ends in /openai/v1).
AZURE_OPENAI_API_KEY=<your-project-key>
LLM_BASE_URL=https://zamokuhlemasondo6-1675-resource.services.ai.azure.com/openai/v1
LLM_MODEL=Phi-4-mini                 # deployment name, sent in the request BODY

# Optional: separate cheaper model for chat (leave same if not deployed).
# CHAT_LLM_PROVIDER=azure_sdk
# CHAT_LLM_MODEL=Phi-4-mini
# CHAT_AZURE_OPENAI_API_KEY=
 
# (OpenRouter/other providers: LLM_PROVIDER=openai + OPENROUTER_API_KEY if you ever
#  go back to OpenRouter; LLM_PROVIDER=azure_ai for the AI Foundry project endpoint.)

# --- Embeddings: in-process open-source model ---
# "local"  = sentence-transformers model inside Django/Celery (needs the extra dep)
# "hash"   = built-in offline embedder (automatic fallback if lib missing)
# "openai" = OpenAI-compatible /embeddings endpoint (needs EMBEDDINGS_* below)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5   # 384-dim; alternatives: BAAI/bge-base-en-v1.5 (768), intfloat/e5-base-v2
EMBEDDING_QUERY_PREFIX=                        # e.g. "query: " required by E5 models
EMBEDDING_PASSAGE_PREFIX=                      # e.g. "passage: " required by E5 models
EMBEDDING_DIM=384                              # MUST match the chosen model's output dims
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=

# --- RAG tuning ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=6
CELERY_TASK_ALWAYS_EAGER=0
