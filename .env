# --- Core Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# --- Database ---
# Leave unset for quick local dev on SQLite.
# Production example: postgres://fundza:fundza@localhost:5432/fundzaai
DATABASE_URL=

# --- Redis (Celery broker + Channels layer) ---
# Leave unset to use in-memory/in-process fallbacks in development.
REDIS_URL=

# --- LLM via OpenRouter (OpenAI-compatible) ---
# Paste your OpenRouter key here. Chosen for cheap + fast + capable:
#   ibm-granite/granite-4.0-h-micro   $0.017/M in, $0.112/M out (responds ~1.5s)
# Alternatives (all verified): inclusionai/ling-3.0-flash, qwen/qwen3.7-flash
OPENROUTER_API_KEY=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
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=ibm-granite/granite-4.0-h-micro
LLM_APP_URL=https://fundza.ai
LLM_APP_TITLE=FundzaAI

# --- Embeddings: in-process open-source model ---
# "local" = sentence-transformers model loaded inside Django/Celery
EMBEDDING_PROVIDER=local
# Default: BAAI/bge-small-en-v1.5 (384-dim, CPU-friendly, MIT license)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PREFIX=
EMBEDDING_PASSAGE_PREFIX=
EMBEDDING_DIM=384
